[gd_resource type="Theme" load_steps=3 format=3]

[ext_resource type="FontFile" path="res://src/assets/fonts/OpenSans_SemiBold.woff2" id="1_text"]
[ext_resource type="FontFile" path="res://src/assets/fonts/Twemoji.Mozilla.ttf" id="2_emoji"]

[sub_resource type="FontVariation" id="FontVariation_main"]
base_font = ExtResource("1_text")
fallbacks = [ExtResource("2_emoji")]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_normal"]
content_margin_left = 20.0
content_margin_top = 10.0
content_margin_right = 20.0
content_margin_bottom = 10.0
bg_color = Color(0.22, 0.26, 0.35, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

